<section id="Confidence-{{ section.id }}" class="confidence-section color-{{ section.settings.color_scheme }}">
  <div class="confidence-section__inner page-width">
    <div class="confidence-section__panel">
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="confidence-section__grid">
        <div class="confidence-section__item">
          <span aria-hidden="true">
            {{ 'icon-cardboard-box.svg' | inline_asset_content }}
          </span>
          <strong>30-Day Free Returns</strong>
          <p>Return Label Included</p>
        </div>
        <div class="confidence-section__item">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation">
              <path fill="currentColor" d="M12 2.2 14.1 4l2.7-.1 1 2.5 2.2 1.6-.9 2.6.9 2.6-2.2 1.6-1 2.5-2.7-.1L12 19l-2.1-1.8-2.7.1-1-2.5L4 13.2l.9-2.6L4 8l2.2-1.6 1-2.5 2.7.1L12 2.2Z" />
              <path fill="#171717" d="m10.7 13.9-2.2-2.2 1.1-1.1 1.1 1.1 2.8-2.8 1.1 1.1-3.9 3.9Z" />
              <path fill="currentColor" d="M8.2 17.5v4.3l3.8-2 3.8 2v-4.3l-3.8 1.6-3.8-1.6Z" />
            </svg>
          </span>
          <strong>10-Year Warranty</strong>
          <p>Quality You Can Trust</p>
        </div>
        <div class="confidence-section__item">
          <span aria-hidden="true">
            {{ 'icon-fast-delivery-truck.svg' | inline_asset_content }}
          </span>
          <strong>Same-Day Free Shipping</strong>
          <p>All Orders Over $85</p>
        </div>
        <div class="confidence-section__item">
          <span aria-hidden="true">
            {{ 'icon-shield-plus.svg' | inline_asset_content }}
          </span>
          <strong>Secure Shopping</strong>
          <p>Protection Against Fraud</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #Confidence-{{ section.id }} {
    background: #fff;
    color: #151515;
  }

  #Confidence-{{ section.id }} .confidence-section__inner {
    padding-top: clamp(24px, 4vw, 56px);
    padding-bottom: clamp(56px, 7vw, 92px);
  }

  #Confidence-{{ section.id }} .confidence-section__panel {
    padding: clamp(48px, 5vw, 72px) clamp(24px, 5vw, 76px);
    border-radius: 8px;
    background: #f7f7f9;
    text-align: center;
  }

  #Confidence-{{ section.id }} h2 {
    margin: 0;
    color: #171717;
    font-size: clamp(2.4rem, 2.6vw, 3.4rem);
    font-weight: 950;
    letter-spacing: -.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  #Confidence-{{ section.id }} .confidence-section__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px;
    margin-top: clamp(52px, 6vw, 86px);
  }

  #Confidence-{{ section.id }} .confidence-section__item {
    display: grid;
    justify-items: center;
    color: #1b1b1b;
  }

  #Confidence-{{ section.id }} .confidence-section__item > span {
    display: grid;
    place-items: center;
    width: 128px;
    height: 128px;
    margin-bottom: 28px;
    border-radius: 50%;
    background: #171717;
    color: #fff;
    font-size: 2.8rem;
    font-weight: 950;
    line-height: 1;
  }

  #Confidence-{{ section.id }} .confidence-section__item svg {
    display: block;
    width: 68px;
    height: 68px;
  }

  #Confidence-{{ section.id }} .confidence-section__item strong {
    display: block;
    font-size: clamp(1.6rem, 1.4vw, 2rem);
    font-weight: 900;
    letter-spacing: -.03em;
    line-height: 1.12;
  }

  #Confidence-{{ section.id }} .confidence-section__item p {
    margin: 16px 0 0;
    color: #777;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media screen and (max-width: 989px) {
    #Confidence-{{ section.id }} .confidence-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #Confidence-{{ section.id }} .confidence-section__panel {
      padding: 38px 18px;
    }

    #Confidence-{{ section.id }} .confidence-section__grid {
      grid-template-columns: 1fr;
      gap: 34px;
      margin-top: 42px;
    }

    #Confidence-{{ section.id }} .confidence-section__item > span {
      width: 96px;
      height: 96px;
      margin-bottom: 20px;
    }

    #Confidence-{{ section.id }} .confidence-section__item svg {
      width: 54px;
      height: 54px;
    }
  }
</style>

{% schema %}
{
  "name": "Buy with confidence",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy with confidence" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Buy with confidence" }
  ]
}
{% endschema %}
