<section id="LabProof-{{ section.id }}" class="lab-proof" aria-labelledby="LabProofHeading-{{ section.id }}">
  <div class="page-width">
    <h2 id="LabProofHeading-{{ section.id }}" class="lab-proof__heading">{{ section.settings.heading | escape }}</h2>
    <div class="lab-proof__panel">
      <div class="lab-proof__media">
        <video controls autoplay muted loop playsinline preload="metadata" aria-label="Seat cover side airbag deployment test" width="1280" height="800">
          <source src="{{ 'airbag-1280-800-optimized.mp4' | asset_url }}" type="video/mp4">
          Your browser does not support embedded video.
        </video>
      </div>
      <div class="lab-proof__content">
        <h3>{{ section.settings.title | escape }}</h3>
        <div class="lab-proof__text">{{ section.settings.description }}</div>
        {% if section.settings.button_link != blank and section.settings.button_label != blank %}
          <a class="lab-proof__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #LabProof-{{ section.id }} { background: #fff; color: #1a1a1a; padding-bottom: clamp(48px, 6vw, 88px); }
  #LabProof-{{ section.id }} .lab-proof__heading {
    margin: 0 0 clamp(36px, 4vw, 60px); text-align: center;
    font-size: clamp(2.4rem, 2.6vw, 3.4rem); font-weight: 950;
    letter-spacing: -.03em; line-height: 1.15; text-transform: uppercase;
  }
  #LabProof-{{ section.id }} .lab-proof__panel {
    display: grid; grid-template-columns: 1.15fr 1fr; align-items: center;
    gap: clamp(32px, 6vw, 88px); padding: clamp(40px, 7vw, 100px) clamp(24px, 7vw, 112px);
    border-radius: 8px; background: #1a1a1a; color: #fff;
  }
  #LabProof-{{ section.id }} video {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 10;
    border-radius: 6px; background: #111;
  }
  #LabProof-{{ section.id }} h3 {
    margin: 0 0 32px; color: #fff; font-size: clamp(2.4rem, 2.5vw, 3.4rem);
    font-weight: 800; line-height: 1.2; letter-spacing: -.025em;
  }
  #LabProof-{{ section.id }} .lab-proof__text { color: #ddd; font-size: clamp(1.6rem, 1.4vw, 2rem); line-height: 1.5; }
  #LabProof-{{ section.id }} .lab-proof__text p { margin: 0; }
  #LabProof-{{ section.id }} .lab-proof__button {
    display: inline-flex; align-items: center; justify-content: center; margin-top: 48px;
    min-height: 60px; padding: 18px 40px; border-radius: 6px;
    background: #fff; color: #1a1a1a; text-decoration: none;
    font-size: 2rem; font-weight: 800; line-height: 1.3; text-align: center;
  }
  #LabProof-{{ section.id }} .lab-proof__button:hover { background: #eee; }
  #LabProof-{{ section.id }} .lab-proof__button:focus-visible { outline: 3px solid #fff; outline-offset: 5px; }
  @media screen and (max-width: 749px) {
    #LabProof-{{ section.id }} .lab-proof__panel { grid-template-columns: 1fr; gap: 28px; padding: 24px 20px 32px; }
    #LabProof-{{ section.id }} h3 { margin-bottom: 20px; }
    #LabProof-{{ section.id }} .lab-proof__button { margin-top: 28px; width: 100%; padding: 16px 24px; font-size: 1.8rem; }
  }
</style>

{% schema %}
{
  "name": "Lab-tested proof",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "LAB-TESTED PROOF" },
    { "type": "text", "id": "title", "label": "Title", "default": "Airbag-Safe, Guaranteed" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Your seat's side airbags deploy exactly as they should. Our covers are lab tested and certified safe, and they're also airbag-sensor safe, ensuring sensors remain unblocked. Your safety is our #1 priority.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Seat Covers" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Lab-tested proof" }]
}
{% endschema %}
