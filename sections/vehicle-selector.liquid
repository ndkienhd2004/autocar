{{ 'data-vehicle.js' | asset_url | script_tag }}

<section
  id="VehicleSelector-{{ section.id }}"
  class="vehicle-selector color-{{ section.settings.color_scheme }}"
  style="
    --vehicle-selector-bg: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}
      --vehicle-selector-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    {% else %}
      --vehicle-selector-image: url('{{ 'autocar-seat-covers-hero.png' | asset_url }}');
    {% endif %}
  "
>
  <div class="vehicle-selector__inner page-width">
    <div class="vehicle-selector__content">
      {% if section.settings.review_text != blank %}
        <div class="vehicle-selector__review-badge" aria-label="{{ section.settings.review_text | escape }}">
          <span class="vehicle-selector__stars" aria-hidden="true">★★★★★</span>
          <span>{{ section.settings.review_text | escape }}</span>
        </div>
      {% endif %}

      {% if section.settings.hero_heading != blank %}
        <h1 class ="vehicle-selector__hero-heading">{{ section.settings.hero_heading | escape | newline_to_br }}</h1>
      {% endif %}

      {% if section.settings.promo_text != blank %}
        <p class="vehicle-selector__promo">{{ section.settings.promo_text | escape }}</p>
      {% endif %}
    </div>

    <div class="vehicle-selector__panel">
      {% if section.settings.heading != blank %}
        <h2 class="vehicle-selector__heading">
          <span>{{ section.settings.heading | escape }}</span>
        </h2>
      {% endif %}

      <form class="vehicle-selector__form" data-vehicle-selector>
<label class="vehicle-selector__field"><span class="visually-hidden">Year</span><select data-vehicle-year required><option value="">Year</option></select></label>
<label class="vehicle-selector__field"><span class="visually-hidden">Make</span><select data-vehicle-make required><option value="">Make</option></select></label>
<label class="vehicle-selector__field"><span class="visually-hidden">Model</span><select data-vehicle-model required><option value="">Model</option></select></label>
        <button class="vehicle-selector__submit button" type="submit">
          <span class="vehicle-selector__button-label--desktop">{{ section.settings.button_label | escape }}</span>
          <span class="vehicle-selector__button-label--mobile">Go</span>
        </button>
        <p class="vehicle-selector__error" data-vehicle-error role="alert" hidden>
          Please enter your vehicle information.
        </p>
      </form>
    </div>

    <div class="vehicle-selector__benefits" aria-label="Store benefits">
      <div class="vehicle-selector__benefit">
        <span class="vehicle-selector__benefit-icon" aria-hidden="true">
          {{ 'icon-return-package.svg' | inline_asset_content }}
        </span>
        <span>30-Day Returns</span>
      </div>
      <div class="vehicle-selector__benefit">
        <span class="vehicle-selector__benefit-icon" aria-hidden="true">
          {{ 'icon-shield-check-outline.svg' | inline_asset_content }}
        </span>
        <span>3 Year Warranty</span>
      </div>
      <div class="vehicle-selector__benefit">
        <span class="vehicle-selector__benefit-icon" aria-hidden="true">
          {{ 'icon-24-hours-support.svg' | inline_asset_content }}
        </span>
        <span>24/7 Support</span>
      </div>
    </div>
  </div>

  <div class="vehicle-selector__press-bar" aria-label="Brand stats">
    <strong>400,000+ SEATS COVERED</strong>
    <span aria-hidden="true"></span>
    <strong>DIGITAL JOURNAL</strong>
    <strong>Cars & Coffee</strong>
    <strong>NEWSnet</strong>
    <strong>SEMA SHOW</strong>
    <strong>FOX NEWS</strong>
  </div>
</section>

<style>
  #VehicleSelector-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: var(--vehicle-selector-bg);
    background-image: linear-gradient(90deg, rgba(0, 0, 0, .72), rgba(0, 0, 0, .34) 48%, rgba(0, 0, 0, .08)), var(--vehicle-selector-image);
    background-position: center;
    background-size: cover;
    color: #fff;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__inner {
    display: flex;
    min-height: 650px;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(76px, 9vw, 132px);
    padding-bottom: 112px;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__content {
    width: 100%;
    max-width: 620px;
    margin-right: auto;
    margin-left: auto;
    transform: translateX(calc((620px - 1080px) / 2));
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__review-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border: 1px solid rgba(255, 255, 255, .68);
    border-radius: 6px;
    background: rgba(0, 0, 0, .24);
    color: #fff;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__stars {
    color: #43513A;
    letter-spacing: 2px;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__hero-heading {
    max-width: 560px;
    margin: 26px 0 18px;
    color: #fff;
    font-size: clamp(3.6rem, 5.2vw, 7rem);
    font-weight: 900;
    letter-spacing: -.04em;
    line-height: .95;
    text-transform: uppercase;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__promo {
    margin: 0 0 30px;
    color: #fff;
    font-size: clamp(1.4rem, 1.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: .02em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__panel {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    max-width: 1080px;
    min-width: 0;
    margin: 76px auto 0;
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, .8);
    border-radius: 0 12px 12px;
    background: rgba(255, 255, 255, .08);
    backdrop-filter: blur(2px);
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__heading {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    margin: 0;
    padding: 14px 28px;
    border: 1px solid rgba(255, 255, 255, .8);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    background: #43513A;
    font-size: clamp(1.8rem, 2.4vw, 2.8rem);
    font-weight: 900;
    line-height: 1;
    color: #fff;
    text-transform: uppercase;
    transform: translateY(-100%);
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__form {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    gap: 16px;
    align-items: center;
    min-width: 0;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__field {
    position: relative;
    min-width: 0;
  }

  #VehicleSelector-{{ section.id }} select {
    box-sizing: border-box;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 58px;
    padding: 0 48px 0 22px;
    border: 1px solid rgba(255, 255, 255, .52);
    border-radius: 8px;
    appearance: none;
    background: rgba(255, 255, 255, .72);
    color: #171717;
    font-size: 1.6rem;
    font-weight: 800;
    cursor: pointer;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__field::after {
    position: absolute;
    top: 50%;
    right: 20px;
    width: 10px;
    height: 10px;
    border-right: 3px solid #171717;
    border-bottom: 3px solid #171717;
    content: '';
    pointer-events: none;
    transform: translateY(-65%) rotate(45deg);
  }

  #VehicleSelector-{{ section.id }} select:disabled {
    cursor: not-allowed;
    opacity: .65;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__submit {
    --buttons-radius: 8px;
    --buttons-radius-outset: 8px;
    min-height: 58px;
    padding: 0 32px;
    border: 0;
    border-radius: 8px !important;
    background: #43513A;
    color: #fff;
    font-size: 1.8rem;
    font-weight: 900;
    white-space: nowrap;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__submit::before,
  #VehicleSelector-{{ section.id }} .vehicle-selector__submit::after {
    border-radius: 8px !important;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__button-label--mobile {
    display: none;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__error {
    grid-column: 1 / -1;
    margin: 0;
    color: #ffd5d5;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__benefits {
    display: flex;
    justify-content: center;
    gap: clamp(42px, 7vw, 84px);
    margin-top: 42px;
    color: #fff;
    font-size: 1.45rem;
    font-weight: 800;
    text-align: center;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__benefit {
    display: grid;
    gap: 8px;
    justify-items: center;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__benefit-icon {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-size: 1.2rem;
    line-height: 1;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__benefit-icon svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__press-bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(22px, 3.5vw, 48px);
    min-height: 78px;
    padding: 18px 24px;
    background: #000;
    color: #fff;
    font-size: clamp(1.3rem, 1.4vw, 2rem);
    font-weight: 900;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  #VehicleSelector-{{ section.id }} .vehicle-selector__press-bar span {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, .75);
  }

  @media screen and (max-width: 989px) {
    #VehicleSelector-{{ section.id }} {
      background-position: center right 28%;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__inner {
      min-height: 620px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__content {
      max-width: 100%;
      transform: none;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__submit {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    #VehicleSelector-{{ section.id }} {
      background-image: linear-gradient(rgba(0, 0, 0, .68), rgba(0, 0, 0, .5)), var(--vehicle-selector-image);
      background-position: center center;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__inner {
      display: flex;
      min-height: 640px;
      padding: 80px 16px 64px;
      justify-content: center;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__content {
      display: contents;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__review-badge {
      order: 4;
      display: inline-flex;
      align-self: center;
      justify-content: center;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      margin-right: auto;
      margin-left: auto;
      gap: 10px;
      margin-top: 36px;
      padding: 12px 20px;
      border-width: 2px;
      border-radius: 9px;
      background: rgba(0, 0, 0, .3);
      font-size: clamp(1.5rem, 3vw, 1.9rem);
      white-space: nowrap;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__stars {
      letter-spacing: 2px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__hero-heading {
      order: 1;
      max-width: none;
      margin: 0 0 28px;
      font-size: clamp(2.4rem, 6.5vw, 3.6rem);
      line-height: .95;
      white-space: nowrap;
      text-align: center;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__hero-heading br {
      display: none;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__promo {
      order: 2;
      max-width: 680px;
      margin: 0 auto;
      font-size: clamp(1.4rem, 3.2vw, 2rem);
      font-weight: 400;
      line-height: 1.2;
      text-align: center;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__panel {
      order: 3;
      width: 100%;
      max-width: none;
      margin: 48px 0 0;
      padding: 24px 10px 20px;
      box-sizing: border-box;
      border-radius: 0 10px 10px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__heading {
      left: -1px;
      padding: 13px 20px 7px;
      border-color: rgba(255, 255, 255, .9);
      background: #43513A;
      font-size: clamp(1.8rem, 4.8vw, 2.2rem);
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__form {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    #VehicleSelector-{{ section.id }} select,
    #VehicleSelector-{{ section.id }} .vehicle-selector__submit {
      min-height: 52px;
      font-size: clamp(1.45rem, 3.6vw, 1.8rem);
    }

    #VehicleSelector-{{ section.id }} select {
      padding: 0 34px 0 16px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__submit {
      grid-column: auto;
      width: 100%;
      min-width: 0;
      border-radius: 8px !important;
      padding: 0 12px;
      font-size: clamp(1.7rem, 4vw, 2.1rem);
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__button-label--desktop {
      display: none;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__button-label--mobile {
      display: inline;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__benefits {
      order: 5;
      width: 100%;
      gap: 20px;
      justify-content: space-around;
      margin-top: 48px;
      font-size: clamp(1.2rem, 2.8vw, 1.7rem);
      white-space: nowrap;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__benefit-icon {
      width: 50px;
      height: 50px;
      font-size: 1.25rem;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__benefit-icon svg {
      width: 30px;
      height: 30px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__press-bar {
      display: none;
    }
  }

  @media screen and (max-width: 480px) {
    #VehicleSelector-{{ section.id }} .vehicle-selector__inner {
      padding-right: 4px;
      padding-left: 4px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__hero-heading {
      font-size: clamp(2.4rem, 6.8vw, 3.2rem);
      white-space: nowrap;
      transform: translateY(-24px);
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__promo {
      transform: translateY(-24px);
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__panel {
      padding-right: 4px;
      padding-left: 4px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__heading {
      left: -1px;
      padding-right: 15px;
      padding-bottom: 5px;
      padding-left: 15px;
      font-size: 1.55rem;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__form {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, .72fr);
      gap: 6px;
    }

    #VehicleSelector-{{ section.id }} select {
      padding-right: 20px;
      padding-left: 8px;
      font-size: 1.25rem;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__field::after {
      right: 10px;
      width: 8px;
      height: 8px;
      border-width: 2px;
    }

    #VehicleSelector-{{ section.id }} .vehicle-selector__submit {
      min-width: 0;
      padding-right: 4px;
      padding-left: 4px;
      min-height: 52px;
      border-radius: 8px !important;
      font-size: 1.2rem;
    }
  }
</style>

<script src="{{ 'vehicle-dropdowns.js' | asset_url }}" defer></script>

<style>
#VehicleSelector-{{ section.id }} .vehicle-selector__field::after { display:none; }
#VehicleSelector-{{ section.id }} select::placeholder { color:#666; opacity:0.65; }
#VehicleSelector-{{ section.id }} .vehicle-selector__form { grid-template-columns:repeat(3,minmax(0,1fr)) auto; }
#VehicleSelector-{{ section.id }} .vehicle-selector__submit { grid-column:auto; }
@media(max-width:480px) { #VehicleSelector-{{ section.id }} .vehicle-selector__form { grid-template-columns:1fr; } }
</style>
<style>
body:has(#VehicleSelector-{{ section.id }}) .header__inline-menu a,
body:has(#VehicleSelector-{{ section.id }}) .header__inline-menu summary,
body:has(#VehicleSelector-{{ section.id }}) .header__inline-menu span {
  color: #43513A !important;
}
body:has(#VehicleSelector-{{ section.id }}) .cart-count-bubble {
  background: #43513A !important;
  color: #fff !important;
}
</style>
<style>
#VehicleSelector-{{ section.id }} .vehicle-selector__submit {
  --color-button: 67, 81, 58;
  --border-opacity: 1;
  border-color: #43513A !important;
}
#VehicleSelector-{{ section.id }} .vehicle-selector__submit::before,
#VehicleSelector-{{ section.id }} .vehicle-selector__submit::after {
  border-color: #43513A !important;
  box-shadow: none !important;
}
</style>
{% schema %}
{
  "name": "Vehicle selector",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Select your vehicle"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review text",
      "default": "4.9/5 from 1,411 Verified Reviews"
    },
    {
      "type": "textarea",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Transform\nyour interior"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo text",
      "default": "🔥 Get $139 in free premium add-ons with every seat cover order | Ends 09/30"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Let's go"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#171717"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Vehicle selector"
    }
  ]
}
{% endschema %}
