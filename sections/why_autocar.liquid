<section id="WhyAutocar-{{ section.id }}" class="why-autocar color-{{ section.settings.color_scheme }}">
  <div class="why-autocar__inner page-width">
    <div class="why-autocar__header">
      {% if section.settings.eyebrow != blank %}
        <p class="why-autocar__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="why-autocar__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="why-autocar__showcase">
      <a class="why-autocar__image-card why-autocar__image-card--seat" href="{{ section.settings.seat_link }}" aria-label="{{ section.settings.seat_card_title | escape }}">
        {% if section.settings.seat_image != blank %}
          {{ section.settings.seat_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 700, 900, 1100, 1400', alt: section.settings.seat_card_title }}
        {% else %}
          <img src="{{ 'custom-fit-seat-interior.png' | asset_url }}" alt="{{ section.settings.seat_card_title | escape }}" width="1672" height="941" loading="lazy">
        {% endif %}
        <div class="why-autocar__image-overlay">
          <strong>{{ section.settings.seat_card_title | escape }}</strong>
          <span>{{ section.settings.card_cta | escape }}</span>
        </div>
      </a>

      <div class="why-autocar__feature-panel why-autocar__feature-panel--seat">
        <h3>{{ section.settings.seat_heading | escape }}</h3>
        <div class="why-autocar__feature-list">
          <div class="why-autocar__feature">
            <span class="why-autocar__feature-icon" aria-hidden="true">
              {{ 'icon-dumbbell.svg' | inline_asset_content }}
            </span>
            <div>
              <strong>Custom-Fit Design</strong>
              <p>Tailored for your exact vehicle.</p>
            </div>
          </div>
          <div class="why-autocar__feature">
            <span class="why-autocar__feature-icon" aria-hidden="true">
              {{ 'icon-sitting-chair.svg' | inline_asset_content }}
            </span>
            <div>
              <strong>Ride in Comfort</strong>
              <p>Premium memory foam and built in lumbar support.</p>
            </div>
          </div>
          <div class="why-autocar__feature">
            <span class="why-autocar__feature-icon" aria-hidden="true">
              {{ 'icon-shield-fill-check.svg' | inline_asset_content }}
            </span>
            <div>
              <strong>Spill & Scratch Protection</strong>
              <p>Guards from pets, spills, dirt, and everyday life.</p>
            </div>
          </div>
          <div class="why-autocar__feature">
            <span class="why-autocar__feature-icon" aria-hidden="true">
              {{ 'icon-patch-check-fill.svg' | inline_asset_content }}
            </span>
            <div>
              <strong>Easy DIY Install</strong>
              <p>Tool-free and hassle-free installation.</p>
            </div>
          </div>
        </div>
      </div>

  </div>
</section>

<style>
  #WhyAutocar-{{ section.id }} {
    background: #fff;
    color: #151515;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__inner {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(24px, 3vw, 40px);
  }

  #WhyAutocar-{{ section.id }} .why-autocar__header {
    margin-bottom: clamp(48px, 6vw, 86px);
    text-align: center;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__eyebrow {
    margin: 0 0 12px;
    color: #242424;
    font-size: clamp(1.4rem, 1.1vw, 1.8rem);
    font-weight: 500;
    line-height: 1.15;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__heading {
    margin: 0;
    color: #171717;
    font-size: clamp(2.4rem, 2.6vw, 3.4rem);
    font-weight: 950;
    letter-spacing: -.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(34px, 5vw, 74px) clamp(32px, 6vw, 96px);
    align-items: center;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-card {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 0;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    background: #111;
    color: #fff;
    text-decoration: none;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-card img,
  #WhyAutocar-{{ section.id }} .why-autocar__image-card svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    transition: transform .35s ease;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-card:hover img {
    transform: scale(1.03);
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-card::after {
    position: absolute;
    inset: auto 0 0;
    height: 46%;
    background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, .76));
    content: '';
    pointer-events: none;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-overlay {
    position: absolute;
    right: 32px;
    bottom: 32px;
    left: 32px;
    z-index: 1;
    display: grid;
    gap: 18px;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-overlay strong {
    color: #fff;
    font-size: clamp(1.8rem, 1.8vw, 2.6rem);
    font-weight: 950;
    letter-spacing: -.03em;
    line-height: 1;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-overlay span {
    color: #fff;
    font-size: 1.4rem;
    font-weight: 800;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__image-overlay span::after {
    display: inline-block;
    margin-left: 12px;
    border-top: 3px solid currentColor;
    border-right: 3px solid currentColor;
    width: 12px;
    height: 12px;
    content: '';
    transform: rotate(45deg);
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature-panel {
    max-width: 620px;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature-panel h3 {
    margin: 0 0 46px;
    color: #000;
    font-size: clamp(2.2rem, 2.4vw, 3.2rem);
    font-weight: 950;
    letter-spacing: -.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature-list {
    display: grid;
    gap: 28px;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature-icon {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #b9b9b9;
    color: #fff;
    font-weight: 950;
    line-height: 1;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature-icon {
    width: 64px;
    height: 64px;
    font-size: 2.6rem;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature-icon svg {
    display: block;
    width: 40px;
    height: 40px;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature strong {
    display: block;
    color: #202020;
    font-size: clamp(1.6rem, 1.4vw, 2rem);
    font-weight: 900;
    letter-spacing: -.03em;
    line-height: 1.12;
  }

  #WhyAutocar-{{ section.id }} .why-autocar__feature p {
    margin: 6px 0 0;
    color: #767676;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    #WhyAutocar-{{ section.id }} .why-autocar__showcase {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__feature-panel {
      max-width: none;
    }

  }

  @media screen and (max-width: 749px) {
    #WhyAutocar-{{ section.id }} .why-autocar__inner {
      padding-top: 24px;
      padding-bottom: 24px;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__header {
      margin-bottom: 34px;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__image-card {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__image-overlay {
      right: 22px;
      bottom: 22px;
      left: 22px;
      gap: 12px;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__feature-panel h3 {
      margin-bottom: 28px;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__feature-list {
      gap: 22px;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__feature {
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 18px;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__feature-icon {
      width: 52px;
      height: 52px;
      font-size: 2.3rem;
    }

    #WhyAutocar-{{ section.id }} .why-autocar__feature-icon svg {
      width: 34px;
      height: 34px;
    }

  }
</style>

{% schema %}
{
  "name": "Why AutoCar",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tailored. Tested. Trusted." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why AutoCar?" },
    { "type": "image_picker", "id": "seat_image", "label": "Seat cover image" },
    { "type": "text", "id": "seat_card_title", "label": "Seat card title", "default": "Custom-Fit Seat Covers" },
    { "type": "url", "id": "seat_link", "label": "Seat card link" },
    { "type": "text", "id": "seat_heading", "label": "Seat feature heading", "default": "Seat covers that fit. And stay." },
    { "type": "text", "id": "card_cta", "label": "Card CTA", "default": "Shop Now" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Why AutoCar" }
  ]
}
{% endschema %}
