{%- liquid
  assign total_savings = cart.total_discount
  for item in cart.items
    if item.variant.compare_at_price > item.original_price
      assign unit_savings = item.variant.compare_at_price | minus: item.original_price
      assign line_savings = unit_savings | times: item.quantity
      assign total_savings = total_savings | plus: line_savings
    endif
  endfor
-%}
{{- total_savings -}}
