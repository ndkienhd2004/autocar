{%- comment -%}
  FREE GIFTS grid. Steering + neck pillows: one box per unique seat color.
  Badge qty = total paid quantity for that color (matches Impact theme cũ).
  Usage: {% render 'free-gifts-grid' %}
{%- endcomment -%}

<style>
  .free-gifts-grid__heading {
    margin: 0 0 12px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #333;
    font-family: inherit;
  }

  .free-gifts-grid__box {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 8px;
    padding: 8px;
    background: #fff;
    border: 1.5px solid #3d5a35;
    border-radius: 10px;
  }

  .free-gifts-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }

  .free-gifts-grid__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .free-gifts-grid__badge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    background: #82a178;
    border-radius: 4px;
  }

  .free-gifts-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    background: #f5f5f5;
  }

  .free-gifts-grid__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    min-width: 0;
  }

  .free-gifts-grid__title {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    color: #333;
    text-align: center;
  }

  .free-gifts-grid__prices {
    font-size: 10px;
    line-height: 1;
    margin: 3px !important;
  }

  .free-gifts-grid__price-current {
    font-weight: 600;
    color: #5e7d4c;
    font-size: 14px;
  }

  .free-gifts-grid__price-compare {
    font-size: 13px;
    color: red;
    text-decoration: line-through;
  }

  @media screen and (min-width: 700px) {
    .free-gifts-grid__heading {
      font-size: 18px;
    }

    .free-gifts-grid__box {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 24px;
      padding: 20px;
    }

    .free-gifts-grid__item {
      flex-direction: row;
      align-items: center;
      text-align: left;
    }

    .free-gifts-grid__media {
      flex-shrink: 0;
      width: 72px;
      height: 72px;
      aspect-ratio: auto;
    }

    .free-gifts-grid__badge {
      min-width: 22px;
      height: 22px;
      padding: 0 5px;
      font-size: 12px;
    }

    .free-gifts-grid__image {
      width: 72px;
      height: 72px;
    }

    .free-gifts-grid__info {
      align-items: flex-start;
      line-height: 1;
    }

    .free-gifts-grid__title {
      font-size: 12px;
      line-height: 1.35;
      text-align: left;
    }

    .free-gifts-grid__prices {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px;
      margin: 0;
      font-size: 14px;
      line-height: 1.2;
    }
  }

  @media (max-width: 575px) {
    .free-gifts-grid__info {
      flex-direction: column-reverse;
    }
  }
</style>

{%- assign warranty_in_cart = false -%}
{%- for item in cart.items -%}
  {%- if item.product.handle == '2-year-warranty' -%}
    {%- assign warranty_in_cart = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
<div class="free-gifts-grid" aria-label="Free gifts" style="padding-top: 3px;">
  <div class="free-gifts-grid__box">
    {%- for gift in cart.items -%}
      {%- if gift.final_line_price == 0 -%}
        <article class="free-gifts-grid__item" data-gift-key="{{ gift.key | escape }}">
          <div class="free-gifts-grid__media">
            <span class="free-gifts-grid__badge">{{ gift.quantity }}</span>
            {%- if gift.image -%}
              {{ gift.image | image_url: width: 180 | image_tag: class: 'free-gifts-grid__image', loading: 'lazy', alt: gift.product.title }}
            {%- endif -%}
          </div>
          <div class="free-gifts-grid__info">
            <h3 class="free-gifts-grid__title">{{ gift.product.title | escape }}</h3>
            {%- unless gift.product.has_only_default_variant -%}
              <span>{{ gift.variant.title | escape }}</span>
            {%- endunless -%}
            <p class="free-gifts-grid__prices">
              <span class="free-gifts-grid__price-current">{{ gift.final_price | money }}</span>
              {%- assign gift_compare_price = gift.original_price -%}
              {%- if gift.variant.compare_at_price > gift_compare_price -%}
                {%- assign gift_compare_price = gift.variant.compare_at_price -%}
              {%- endif -%}
              {%- if gift_compare_price > gift.final_price -%}
                <s class="free-gifts-grid__price-compare">{{ gift_compare_price | money }}</s>
              {%- endif -%}
            </p>
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
    {%- unless warranty_in_cart -%}
      <article class="free-gifts-grid__item">
        <div class="free-gifts-grid__media">
          <img class="free-gifts-grid__image"
            src="https://cdn.shopify.com/s/files/1/0773/6321/6538/files/z7840410264631_280a66ddbc8eaedca62b6c5d8afb0138_1a4d6ec8-65e3-4fe9-821b-ed8d939608be.jpg?v=1789540119"
            alt="2 Year Warranty" width="72" height="72" loading="lazy">
        </div>
        <div class="free-gifts-grid__info">
          <h3 class="free-gifts-grid__title">2 Year Warranty</h3>
          <p class="free-gifts-grid__prices"><span class="free-gifts-grid__price-current">{{ 0 | money }}</span></p>
        </div>
      </article>
    {%- endunless -%}
  </div>
</div>
