<section class="bf-gifts" aria-labelledby="BlackFridayGiftTitle-{{ section.id }}">
  <div class="bf-gifts__header">
    <div>
      <p class="bf-gifts__eyebrow">BLACK FRIDAY BONUS</p>
      <h2 id="BlackFridayGiftTitle-{{ section.id }}">YOUR FREE GIFTS ARE INCLUDED.</h2>
    </div>
    <div class="bf-gifts__value"><strong>$109.98</strong><span>VALUE</span></div>
  </div>
  <div class="bf-gifts__grid">
    <article class="bf-gifts__card">
      <div class="bf-gifts__image"><img src="{{ 'bf-gift-neck-pillows-black-grey.png' | asset_url }}" alt="Two black and grey premium neck pillows" width="300" height="260" loading="lazy"></div>
      <h3>2 Premium Neck Pillows</h3>
      <p class="bf-gifts__price"><s>$69.99</s><strong>FREE</strong></p>
    </article>
    <article class="bf-gifts__card">
      <div class="bf-gifts__image"><img src="{{ 'bf-gift-steering-black-grey.webp' | asset_url }}" alt="Black and grey steering wheel cover" width="300" height="260" loading="lazy"></div>
      <h3>Steering Wheel Cover</h3>
      <p class="bf-gifts__price"><s>$39.99</s><strong>FREE</strong></p>
    </article>
  </div>
  <p class="bf-gifts__note"><span aria-hidden="true">✦</span> Automatically included with your seat cover order</p>
  <div class="bf-gifts__assurance">
    {% render 'shipping' %}
  </div>
</section>
<style>
.bf-gifts { margin:20px 0; padding:20px; background:#101010; border:1px solid #3b2528; border-top:4px solid #C8202F; border-radius:16px; color:#fff; }
.bf-gifts .bf-gifts__header { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px; }
.bf-gifts .bf-gifts__eyebrow { margin:0 0 7px; font-size:11px; font-weight:800; letter-spacing:1.8px; color:#ff7581; }
.bf-gifts h2 { margin:0; max-width:340px; font-size:clamp(20px,2vw,27px); font-weight:900; line-height:1.15; letter-spacing:-.4px; color:#fff; }
.bf-gifts .bf-gifts__value { flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:4px; padding:10px 12px; border:1px solid #C8202F; border-radius:9px; background:#201215; }
.bf-gifts__value strong { font-size:23px; line-height:1.1; color:#fff; }
.bf-gifts__value span { color:#ff7581; font-size:10px; font-weight:700; letter-spacing:2px; }
.bf-gifts .bf-gifts__grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.bf-gifts .bf-gifts__card { display:flex; flex-direction:column; min-width:0; padding:10px; border:1px solid #383838; border-radius:12px; background:#1c1c1c; text-align:center; overflow:hidden; }
.bf-gifts .bf-gifts__image { aspect-ratio:1.2; background:white; border-radius:7px; overflow:hidden; }
.bf-gifts__image img { display:block; width:100%; height:100%; object-fit:contain; }
.bf-gifts h3 { margin:10px 0 14px; font-size:13px; font-weight:700; line-height:1.35; color:white; }
.bf-gifts .bf-gifts__price { display:flex; align-items:center; justify-content:center; gap:8px; margin:auto 0 0; font-size:13px; }
.bf-gifts__price s { color:#aaa; }
.bf-gifts__price strong { color:#fff; background:#C8202F; padding:3px 8px; border-radius:4px; font-size:11px; }
.bf-gifts .bf-gifts__note { margin:17px 0 0; text-align:center; font-size:11px; line-height:1.5; color:#d1d1d1; }
.bf-gifts__note span { color:#ff7581; margin-right:4px; }
@media(max-width:480px) { .bf-gifts { padding:16px 12px; } .bf-gifts .bf-gifts__header { gap:8px; } .bf-gifts h2 { font-size:21px; } .bf-gifts .bf-gifts__value { padding:10px 8px; } .bf-gifts__value strong { font-size:21px; } .bf-gifts .bf-gifts__grid { gap:8px; } .bf-gifts .bf-gifts__card { padding:7px; } }
.bf-gifts .bf-gifts__warranty { display:flex; align-items:center; gap:12px; margin-top:12px; padding:12px; border:1px solid #383838; border-radius:10px; background:#1c1c1c; }
.bf-gifts__warranty img { flex-shrink:0; width:48px; height:48px; object-fit:contain; border-radius:6px; background:#fff; }
.bf-gifts__warranty div { display:flex; flex-direction:column; gap:4px; }
.bf-gifts__warranty strong { color:#fff; font-size:14px; }
.bf-gifts__warranty span { color:#bbb; font-size:11px; }
.bf-gifts__warranty b { margin-left:auto; color:#ff7581; font-size:10px; letter-spacing:.6px; }
@media(max-width:380px) { .bf-gifts__warranty b { display:none; } }

.bf-gifts .bf-gifts__card { height:100%; box-sizing:border-box; }
@media(max-width:480px) {
 .bf-gifts h3 { font-size:11px; min-height:30px; margin:8px 0; }
 .bf-gifts .bf-gifts__price { flex-wrap:wrap; gap:4px; font-size:11px; }
 .bf-gifts__price strong { font-size:9px; padding:3px 5px; }
}
</style>

<style>
.bf-gifts .bf-gifts__assurance { margin-top:18px; padding-top:14px; border-top:1px solid #383838; }
.bf-gifts .bf-gifts__assurance .container-shipping { margin:0; padding:10px 0; background:transparent; color:#fff; gap:10px; }
.bf-gifts .bf-gifts__assurance .box-shipping { flex:1; min-width:0; }
.bf-gifts .bf-gifts__assurance svg { fill:currentColor; color:#fff; }
.bf-gifts .bf-gifts__assurance svg path { fill:currentColor; }
.bf-gifts .bf-gifts__assurance .box-shipping p { color:inherit; }
@media(max-width:480px){ .bf-gifts .bf-gifts__assurance .box-shipping { gap:5px; font-size:11px; } .bf-gifts .bf-gifts__assurance .icon-shipping { width:20px; height:20px; flex-shrink:0; } }
</style>
