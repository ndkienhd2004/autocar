{{ 'data-vehicle.js' | asset_url | script_tag }}
<div data-product-vehicle class="dropdown-container">
<strong style="grid-column:1/-1">SELECT YOUR VEHICLE:</strong>
<select class="dropdown-select-year" data-vehicle-year form="{{ form }}" required aria-label="Year"><option value="">Year</option></select><select class="dropdown-select-make" data-vehicle-make form="{{ form }}" required aria-label="Make"><option value="">Make</option></select><select class="dropdown-select-model" data-vehicle-model form="{{ form }}" required aria-label="Model"><option value="">Model</option></select>
<div data-vehicle-trims style="grid-column:1/-1"></div>
<p class="required-text-vehicle" data-required="true" style="color:red;grid-column:1/-1">Please select all info vehicle</p>
</div>
<style>[data-product-vehicle]{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}[data-product-vehicle] select{width:100%;padding:12px;border:2px solid #222;border-radius:5px;background:white;font-size:16px}
[data-product-vehicle] [data-vehicle-trims] {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  min-width:0;
}
[data-product-vehicle] [data-vehicle-trims]:empty { display:none; }
[data-product-vehicle] select {
  box-sizing:border-box;
  min-width:0;
  height:48px;
  margin:0;
  padding:10px 30px 10px 12px;
  line-height:normal;
}
[data-product-vehicle] select:focus-visible {
  outline:2px solid #43513A;
  outline-offset:2px;
  box-shadow:none;
}
@media(max-width:480px) {
  [data-product-vehicle] [data-vehicle-trims] { grid-template-columns:repeat(2,minmax(0,1fr)); }
}

body.seat-covers1-template .product__info-container > [data-product-vehicle] {
  margin-top:0;
  margin-bottom:16px;
  padding:0;
  row-gap:8px;
}
[data-product-vehicle] > strong { margin:0; line-height:1.3; }
[data-product-vehicle] .required-text-vehicle {
  margin:0 !important;
  padding:0;
  line-height:1.35;
  font-size:14px;
}
[data-product-vehicle] [data-vehicle-trims]:empty { display:none !important; }
[data-product-vehicle] select { height:44px; padding-top:8px; padding-bottom:8px; }
</style>
<script src="{{ 'vehicle-dropdowns.js' | asset_url }}" defer></script>
